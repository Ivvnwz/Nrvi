{
  "manifest_version": 3,
  "name": "NRVI - Agente web accesible",
  "version": "0.1.0",
  "description": "Agente conversacional que explica y ayuda a interactuar con páginas web.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": { "service_worker": "background/service-worker.js", "type": "module" },
  "action": {
    "default_title": "Hablar con NRVI",
    "default_popup": "popup/index.html"
  },
  "commands": {
    "toggle-listening": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Activar o detener la escucha de NRVI"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content/context.js", "content/voice.js", "content/agent.js"],
    "run_at": "document_idle"
  }]
}
